{
  "name": "Menstrual & Athletic Health Tracker",
  "short_name": "CycleTracker",
  "description": "AI-Powered Cycle & Biometric Health Tracker for Athletes",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#6d28d9",
